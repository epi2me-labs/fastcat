[submodule "htslib"]
	path = third_party/htslib
	url = https://github.com/samtools/htslib.git
	ignore = dirty
[submodule "zlib-ng"]
	path = third_party/zlib-ng
	url = https://github.com/zlib-ng/zlib-ng.git
	ignore = dirty
[submodule "argp-standalone"]
	path = third_party/argp-standalone
	url = https://github.com/argp-standalone/argp-standalone.git
[submodule "third_party/purrflate"]
	path = third_party/purrflate
	url = ../purrflate.git
	ignore = dirty
